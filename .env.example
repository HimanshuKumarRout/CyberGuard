# CYBERGUARD Configuration Template

# Server Settings
APP_NAME=CYBERGUARD
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & Authentication
JWT_SECRET=super-secret-cyberguard-jwt-token-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Safe Simulation Engine
SIMULATION_MODE=true
AUTO_CONTAINMENT_THRESHOLD=80

# Persistence (Supabase PostgreSQL / Local Fallback)
# Leave blank to use built-in local SQLite fallback (data/cyberguard.db)
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
